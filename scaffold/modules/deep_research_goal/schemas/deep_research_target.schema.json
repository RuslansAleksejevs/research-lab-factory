{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.codex/schemas/deep_research_target.schema.json",
  "title": "Canonical Deep Research Mathematical Target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "problem_id",
    "target_id",
    "statement",
    "acceptance_criteria",
    "anti_targets",
    "traps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "EXACT_MATHEMATICAL_TARGET"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180,
      "pattern": "^(?!\\.{1,2}$)(?!.*[\\\\/])[^\\u0000-\\u001F\\u007F]+$"
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "statement": {
      "$ref": "#/$defs/text"
    },
    "acceptance_criteria": {
      "$ref": "#/$defs/textList"
    },
    "anti_targets": {
      "$ref": "#/$defs/textList"
    },
    "traps": {
      "$ref": "#/$defs/textList"
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "textList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  }
}
